# ==============================================================================
# MediGuide-AI Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your deployment.
# NEVER commit the real .env file containing production secrets to version control.
# ==============================================================================

# Authentication & JWT Configuration
# Required for signing access tokens (HMAC-SHA256). In production, supply a strong random key (>= 32 chars).
MEDIGUIDE_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-key
MEDIGUIDE_TOKEN_EXPIRE_MINUTES=480

# SQLite Persistence Configuration
# Path to local SQLite database file (WAL mode enabled)
MEDIGUIDE_DB_PATH=mediguide.db

# Backend Server Configuration
MEDIGUIDE_HOST=127.0.0.1
MEDIGUIDE_PORT=8000

# Security & CORS Settings
# Comma-separated list of permitted frontend origins
MEDIGUIDE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging Configuration
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
